        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nando.a.g.martines.ecotrack"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f0afe035-9de6-4934-ae91-b3b896d45ef9"
      }
    }
  }
}
