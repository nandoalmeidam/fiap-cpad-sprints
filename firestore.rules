rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function usuarioAtivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    function ehSupervisor() {
      return usuarioAtivo()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'Supervisor';
    }

    match /usuarios/{userId} {

      allow get: if (
        autenticado() && request.auth.uid == userId
      ) || (
        ehSupervisor() && resource.data.perfil == 'Campo'
      );

      allow list: if ehSupervisor();

      allow update: if (
      // O usuário pode atualizar os próprios dados de perfil.
      autenticado()
      && request.auth.uid == userId
      && resource.data.ativo == true
      && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly([
          'nome', 'equipe', 'trecho', 'regiao'
        ])
      && request.resource.data.nome is string
      && request.resource.data.nome.size() >= 2
      && request.resource.data.nome.size() <= 100
      && request.resource.data.get('equipe', '') is string
      && request.resource.data.get('trecho', '') is string
      && request.resource.data.get('regiao', '') is string
      && request.resource.data.get('equipe', '').size() <= 100
      && request.resource.data.get('trecho', '').size() <= 100
      && request.resource.data.get('regiao', '').size() <= 100
    ) || (
      // O Supervisor pode gerenciar dados operacionais de agentes.
      ehSupervisor()
      && resource.data.perfil == 'Campo'
      && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly([
          'equipe', 'trecho', 'regiao'
        ])
      && request.resource.data.equipe is string
      && request.resource.data.trecho is string
      && request.resource.data.regiao is string
      && request.resource.data.equipe.size() <= 100
      && request.resource.data.trecho.size() <= 100
      && request.resource.data.regiao.size() <= 100
    );

      allow create, delete: if false;
    }

    match /ocorrencias/{ocorrenciaId} {

      function dadosValidos() {
        let d = request.resource.data;

        return d.keys().hasAll([
          'titulo', 'descricao', 'tipo', 'criticidade',
          'status', 'usuarioId', 'criadoEm', 'atualizadoEm'
        ])
        && d.keys().hasOnly([
          'titulo', 'descricao', 'tipo', 'criticidade',
          'status', 'usuarioId', 'responsavelId',
          'rodovia', 'trecho', 'regiao', 'km',
          'protocolo', 'perfilRegistro',
          'latitude', 'longitude',
          'fotoUrl', 'fotoCaminho',
          'criadoEm', 'atualizadoEm'
        ])
        && d.titulo is string
        && d.titulo.size() >= 3
        && d.titulo.size() <= 150
        && d.descricao is string
        && d.descricao.size() >= 5
        && d.descricao.size() <= 2000
        && d.tipo is string
        && d.tipo.size() > 0
        && d.tipo.size() <= 100
        && d.criticidade in ['Baixa', 'Média', 'Alta', 'Crítica']
        && d.status in ['Pendente', 'Em andamento', 'Concluída']
        && d.usuarioId is string
        && d.criadoEm is timestamp
        && d.atualizadoEm is timestamp
        && d.get('responsavelId', '') is string
        && d.get('fotoUrl', '') is string
        && d.get('fotoCaminho', '') is string
        && d.get('protocolo', '') is string
        && d.get('perfilRegistro', '') is string
        && (d.get('km', '') is string || d.get('km', '') is number)
        && (d.get('trecho', '') is string || d.get('trecho', '') is number)
        && (d.get('latitude', null) == null ||
            (d.latitude is number && d.latitude >= -90 && d.latitude <= 90))
        && (d.get('longitude', null) == null ||
            (d.longitude is number && d.longitude >= -180 && d.longitude <= 180));
      }

      allow read: if usuarioAtivo();

      allow create: if usuarioAtivo()
        && dadosValidos()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.status == 'Pendente'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;

      allow update: if usuarioAtivo()
        && dadosValidos()
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time
        && (
          (
            ehSupervisor()
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'titulo', 'descricao', 'tipo',
                'criticidade', 'status', 'atualizadoEm'
              ])
          )
          ||
          (
            resource.data.usuarioId == request.auth.uid
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'descricao', 'tipo',
                'criticidade', 'atualizadoEm'
              ])
          )
        );

      allow delete: if ehSupervisor();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
